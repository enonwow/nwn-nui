{
  "version": 1,
  "title": "Encouraged Force OFF - Button",
  "geometry": { "x": -1.0, "y": -1.0, "w": 760.0, "h": 260.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "label",
        "value": "Click same button twice: first click ON, second click OFF."
      },
      { "type": "spacer", "height": 10.0 },
      {
        "type": "row",
        "children": [
          { "type": "spacer" },
          {
            "type": "button",
            "label": "Toggle Encouraged",
            "id": "encForceOffBtn",
            "encouraged": { "bind": "enc_force_off_btn", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
            "width": 260.0,
            "height": 36.0
          },
          { "type": "spacer" }
        ]
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "label",
        "value": "Expected: click #1 -> pulse ON, click #2 -> pulse OFF, click #3 -> pulse ON."
      }
    ]
  }
}
