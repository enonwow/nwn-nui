{
  "version": 1,
  "title": "NuiEncouraged Sync - ListCell Shards",
  "geometry": { "x": -1.0, "y": -1.0, "w": 900.0, "h": 380.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "label",
        "value": "List template shard test: each action column has its own shared NuiId group + encouraged pulse."
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "list",
        "row_count": 5,
        "row_height": 34.0,
        "border": true,
        "scrollbars": "NUI_SCROLLBARS_Y",
        "row_template": [
          [
            { "type": "label", "value": "Quest Entry", "text_halign": "NUI_HALIGN_LEFT", "text_valign": "NUI_VALIGN_MIDDLE" },
            280.0,
            true
          ],
          [
            {
              "type": "button",
              "label": "Track A",
              "id": "encListTrackA",
              "encouraged": { "bind": "enc_list_a", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
              "height": 28.0
            },
            140.0,
            false
          ],
          [
            {
              "type": "button",
              "label": "Track B",
              "id": "encListTrackB",
              "encouraged": { "bind": "enc_list_b", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
              "height": 28.0
            },
            140.0,
            false
          ]
        ],
        "width": 700.0,
        "height": 230.0
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "label",
        "value": "Expected: click Track A -> all A pulse together; click Track B -> all B pulse together."
      }
    ]
  }
}
