{
  "version": 1,
  "title": "NuiEncouraged Sync - Shared ID Pulse",
  "geometry": { "x": -1.0, "y": -1.0, "w": 780.0, "h": 260.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "label",
        "value": "Shared NuiId + encouraged bind: click one button -> both should pulse glow together."
      },
      { "type": "spacer", "height": 10.0 },
      {
        "type": "row",
        "children": [
          { "type": "spacer" },
          {
            "type": "button",
            "label": "Shard Left",
            "id": "encSharedShard",
            "encouraged": { "bind": "enc_shared_state", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
            "width": 220.0,
            "height": 34.0
          },
          { "type": "spacer", "width": 14.0 },
          {
            "type": "button",
            "label": "Shard Right",
            "id": "encSharedShard",
            "encouraged": { "bind": "enc_shared_state", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
            "width": 220.0,
            "height": 34.0
          },
          { "type": "spacer" }
        ]
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "label",
        "value": "Expected: click either -> both get breathing glow pulse (shared ID shard)."
      }
    ]
  }
}
