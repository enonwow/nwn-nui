{
  "version": 1,
  "title": "NuiEncouraged Sync - Shared ID / Dual Bind",
  "geometry": { "x": -1.0, "y": -1.0, "w": 860.0, "h": 280.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "label",
        "value": "Shared NuiId with two different encouraged binds. Useful for route fan-out diagnosis."
      },
      { "type": "spacer", "height": 10.0 },
      {
        "type": "row",
        "children": [
          { "type": "spacer" },
          {
            "type": "button",
            "label": "Dual A",
            "id": "encDualShard",
            "encouraged": { "bind": "enc_dual_a", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
            "width": 220.0,
            "height": 34.0
          },
          { "type": "spacer", "width": 12.0 },
          {
            "type": "button",
            "label": "Dual B",
            "id": "encDualShard",
            "encouraged": { "bind": "enc_dual_b", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
            "width": 220.0,
            "height": 34.0
          },
          { "type": "spacer" }
        ]
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "label",
        "value": "Expected (current auto route): one click may update both binds because route key is shared NuiId."
      }
    ]
  }
}
