{
  "version": 1,
  "title": "Custom P1 - PaginationBar",
  "geometry": { "x": -1.0, "y": -1.0, "w": 660.0, "h": 220.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "row",
        "children": [
          { "type": "button", "label": "Prev", "id": "tblPrev", "width": 90.0 },
          { "type": "label", "value": { "bind": "tbl_page_text", "number_flags": 0, "number_precision": 0, "text_flags": 0 }, "text_halign": "NUI_HALIGN_CENTER", "text_valign": "NUI_VALIGN_MIDDLE", "width": 190.0 },
          { "type": "button", "label": "Next", "id": "tblNext", "width": 90.0 },
          { "type": "spacer" },
          { "type": "label", "value": "Page size", "text_halign": "NUI_HALIGN_RIGHT", "text_valign": "NUI_VALIGN_MIDDLE", "width": 100.0 },
          { "type": "combo", "elements": ["10", "20", "50", "100"], "value": { "bind": "tbl_page_size", "number_flags": 0, "number_precision": 0, "text_flags": 0 }, "id": "tblPageSize", "width": 90.0 }
        ]
      },
      { "type": "spacer", "height": 10.0 },
      {
        "type": "text",
        "value": "Pagination integration test with bind-driven page text and page-size selector.",
        "border": true,
        "scrollbars": "NUI_SCROLLBARS_NONE"
      }
    ]
  }
}
