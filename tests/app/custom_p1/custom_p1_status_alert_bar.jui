{
  "version": 1,
  "title": "Custom P1 - StatusAlertBar",
  "geometry": { "x": -1.0, "y": -1.0, "w": 620.0, "h": 220.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "group",
        "border": true,
        "scrollbars": "NUI_SCROLLBARS_NONE",
        "foreground_color": { "r": 246, "g": 186, "b": 96, "a": 255 },
        "children": [
          {
            "type": "row",
            "children": [
              { "type": "label", "value": { "bind": "alert_message", "number_flags": 0, "number_precision": 0, "text_flags": 0 }, "text_halign": "NUI_HALIGN_LEFT", "text_valign": "NUI_VALIGN_MIDDLE" },
              { "type": "spacer" },
              { "type": "button", "label": "Close", "id": "alertClose", "width": 90.0 }
            ]
          }
        ]
      },
      { "type": "spacer", "height": 10.0 },
      {
        "type": "text",
        "value": "Alert bar integration test (message bind + close action).",
        "border": true,
        "scrollbars": "NUI_SCROLLBARS_NONE"
      }
    ]
  }
}
