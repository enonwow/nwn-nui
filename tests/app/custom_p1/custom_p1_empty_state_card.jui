{
  "version": 1,
  "title": "Custom P1 - EmptyStateCard",
  "geometry": { "x": -1.0, "y": -1.0, "w": 560.0, "h": 280.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      { "type": "spacer" },
      {
        "type": "group",
        "border": true,
        "scrollbars": "NUI_SCROLLBARS_NONE",
        "width": 460.0,
        "children": [
          {
            "type": "col",
            "children": [
              { "type": "label", "value": "No quests found", "text_halign": "NUI_HALIGN_CENTER", "text_valign": "NUI_VALIGN_MIDDLE" },
              { "type": "text", "value": "Try changing filters or refresh data.", "border": false, "scrollbars": "NUI_SCROLLBARS_NONE" },
              { "type": "spacer", "height": 6.0 },
              {
                "type": "row",
                "children": [
                  { "type": "spacer" },
                  { "type": "button", "label": "Refresh", "id": "emptyAction", "encouraged": true, "width": 140.0 },
                  { "type": "spacer" }
                ]
              }
            ]
          }
        ]
      },
      { "type": "spacer" }
    ]
  }
}
