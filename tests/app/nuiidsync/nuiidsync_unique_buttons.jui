{
  "version": 1,
  "title": "NuiId Sync - Unique Buttons",
  "geometry": { "x": -1.0, "y": -1.0, "w": 700.0, "h": 220.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "label",
        "value": "Unique NuiId test: each button should react independently."
      },
      { "type": "spacer", "height": 10.0 },
      {
        "type": "row",
        "children": [
          { "type": "spacer" },
          { "type": "button", "label": "Track A", "id": "btnTrackA", "width": 180.0, "height": 34.0 },
          { "type": "spacer", "width": 14.0 },
          { "type": "button", "label": "Track B", "id": "btnTrackB", "width": 180.0, "height": 34.0 },
          { "type": "spacer" }
        ]
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "label",
        "value": "Expected: click A -> only A reacts; click B -> only B reacts."
      }
    ]
  }
}
