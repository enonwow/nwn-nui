{
  "version": 1,
  "title": "NuiList Template - Single Static Rows",
  "geometry": { "x": -1.0, "y": -1.0, "w": 860.0, "h": 380.0 },
  "resizable": false,
  "collapsed": false,
  "closable": true,
  "transparent": false,
  "border": true,
  "accepts_input": true,
  "size_constraint": null,
  "edge_constraint": null,
  "font": "",
  "root": {
    "type": "col",
    "children": [
      {
        "type": "label",
        "value": "Case A: rows keep the same structure -> one NuiListTemplateCell is enough."
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "list",
        "row_count": 8,
        "row_height": 30.0,
        "border": true,
        "scrollbars": "NUI_SCROLLBARS_Y",
        "row_template": [
          [
            {
              "type": "row",
              "children": [
                {
                  "type": "label",
                  "value": "Quest Entry",
                  "text_halign": "NUI_HALIGN_LEFT",
                  "text_valign": "NUI_VALIGN_MIDDLE"
                },
                { "type": "spacer" },
                {
                  "type": "label",
                  "value": "Static Layout",
                  "text_halign": "NUI_HALIGN_RIGHT",
                  "text_valign": "NUI_VALIGN_MIDDLE"
                }
              ]
            },
            0.0,
            true
          ]
        ],
        "width": 720.0,
        "height": 250.0
      },
      { "type": "spacer", "height": 8.0 },
      {
        "type": "label",
        "value": "Expected: every row is identical because one template drives all rows."
      }
    ]
  }
}
