{
  "order": 50,
  "id": "stat-delta-summary",
  "name": "Stat Delta Summary",
  "description": "Reusable stat row pattern with bind-backed value and colored delta indicator.",
  "tags": ["stat", "delta", "summary", "bind", "row"],
  "jui": {
    "version": 1,
    "title": "Session Metrics",
    "geometry": { "x": -1.0, "y": -1.0, "w": 560.0, "h": 240.0 },
    "resizable": false,
    "collapsed": false,
    "closable": true,
    "transparent": false,
    "border": true,
    "accepts_input": true,
    "size_constraint": null,
    "edge_constraint": null,
    "font": "",
    "root": {
      "type": "col",
      "children": [
        {
          "type": "row",
          "children": [
            { "type": "label", "value": "Damage / Minute" },
            { "type": "spacer" },
            {
              "type": "col",
              "children": [
                {
                  "type": "text",
                  "value": { "bind": "metric_damage_value", "text_flags": 0 },
                  "text_halign": "NUI_HALIGN_RIGHT",
                  "text_valign": "NUI_VALIGN_MIDDLE"
                },
                {
                  "type": "text",
                  "value": { "bind": "metric_damage_delta", "text_flags": 0 },
                  "text_halign": "NUI_HALIGN_RIGHT",
                  "text_valign": "NUI_VALIGN_MIDDLE"
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "children": [
            { "type": "label", "value": "Gold / Hour" },
            { "type": "spacer" },
            {
              "type": "col",
              "children": [
                {
                  "type": "text",
                  "value": { "bind": "metric_gold_value", "text_flags": 0 },
                  "text_halign": "NUI_HALIGN_RIGHT",
                  "text_valign": "NUI_VALIGN_MIDDLE"
                },
                {
                  "type": "text",
                  "value": { "bind": "metric_gold_delta", "text_flags": 0 },
                  "text_halign": "NUI_HALIGN_RIGHT",
                  "text_valign": "NUI_VALIGN_MIDDLE"
                }
              ]
            }
          ]
        },
        {
          "type": "label",
          "value": { "bind": "metric_hint", "text_flags": 0 },
          "text_halign": "NUI_HALIGN_RIGHT",
          "text_valign": "NUI_VALIGN_MIDDLE"
        }
      ]
    }
  }
}
