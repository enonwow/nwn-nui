{
  "order": 31,
  "id": "encouraged-list-dual-track-toggle",
  "name": "Encouraged List Dual Track Toggle",
  "description": "NuiList with two independent encouraged tracks and row-level toggle behavior.",
  "tags": ["encouraged", "list", "row", "toggle", "dual", "track"],
  "jui": {
    "version": 1,
    "title": "Encouraged List Dual Track Toggle",
    "geometry": { "x": -1.0, "y": -1.0, "w": 920.0, "h": 390.0 },
    "resizable": false,
    "collapsed": false,
    "closable": true,
    "transparent": false,
    "border": true,
    "accepts_input": true,
    "size_constraint": null,
    "edge_constraint": null,
    "font": "",
    "root": {
      "type": "col",
      "children": [
        {
          "type": "label",
          "value": "Two encouraged columns in one list. A/B tracks should stay independent per row."
        },
        { "type": "spacer", "height": 8.0 },
        {
          "type": "list",
          "row_count": 6,
          "row_height": 34.0,
          "border": true,
          "scrollbars": "NUI_SCROLLBARS_Y",
          "row_template": [
            [
              { "type": "label", "value": "Quest Entry", "text_halign": "NUI_HALIGN_LEFT", "text_valign": "NUI_VALIGN_MIDDLE" },
              280.0,
              true
            ],
            [
              {
                "type": "button",
                "label": "Track A",
                "id": "encListTrackAToggle",
                "encouraged": { "bind": "enc_list_a_toggle", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
                "height": 28.0
              },
              140.0,
              false
            ],
            [
              {
                "type": "button",
                "label": "Track B",
                "id": "encListTrackBToggle",
                "encouraged": { "bind": "enc_list_b_toggle", "number_flags": 0, "number_precision": 0, "text_flags": 0 },
                "height": 28.0
              },
              140.0,
              false
            ]
          ],
          "width": 700.0,
          "height": 240.0
        },
        { "type": "spacer", "height": 8.0 },
        {
          "type": "label",
          "value": "Expected: click A row N -> A row N on; click same again -> A off; B track unaffected."
        }
      ]
    }
  }
}
