{
  "order": 26,
  "id": "encouraged-toggle",
  "name": "Encouraged Toggle",
  "description": "Click behavior demo for NuiEncouraged: same click toggles off, other click switches active state.",
  "tags": ["encouraged", "toggle", "bind", "click", "sync"],
  "jui": {
    "version": 1,
    "title": "Encouraged Toggle Demo",
    "geometry": { "x": -1.0, "y": -1.0, "w": 860.0, "h": 420.0 },
    "resizable": false,
    "collapsed": false,
    "closable": true,
    "transparent": false,
    "border": true,
    "accepts_input": true,
    "size_constraint": null,
    "edge_constraint": null,
    "font": "",
    "root": {
      "type": "col",
      "children": [
        {
          "type": "label",
          "value": "Top row: unique ids. Click same button twice to disable pulse. Click other to switch."
        },
        { "type": "spacer", "height": 8.0 },
        {
          "type": "row",
          "children": [
            { "type": "spacer" },
            {
              "type": "button",
              "id": "encTopLeft",
              "label": "Top Left",
              "width": 200.0,
              "height": 34.0,
              "encouraged": { "bind": "enc_top_left", "number_flags": 0, "number_precision": 0, "text_flags": 0 }
            },
            { "type": "spacer", "width": 12.0 },
            {
              "type": "button",
              "id": "encTopRight",
              "label": "Top Right",
              "width": 200.0,
              "height": 34.0,
              "encouraged": { "bind": "enc_top_right", "number_flags": 0, "number_precision": 0, "text_flags": 0 }
            },
            { "type": "spacer" }
          ]
        },
        { "type": "spacer", "height": 12.0 },
        {
          "type": "label",
          "value": "List row: click a row button to enable that row; click same row again to disable."
        },
        { "type": "spacer", "height": 6.0 },
        {
          "type": "list",
          "row_count": 4,
          "row_height": 32.0,
          "border": true,
          "scrollbars": "NUI_SCROLLBARS_Y",
          "row_template": [
            [
              { "type": "label", "value": "List Entry", "text_halign": "NUI_HALIGN_LEFT", "text_valign": "NUI_VALIGN_MIDDLE" },
              260.0,
              true
            ],
            [
              {
                "type": "button",
                "id": "encListRowToggle",
                "label": "Select",
                "height": 28.0,
                "encouraged": { "bind": "enc_list_toggle", "number_flags": 0, "number_precision": 0, "text_flags": 0 }
              },
              130.0,
              false
            ]
          ],
          "width": 440.0,
          "height": 170.0
        }
      ]
    }
  }
}
