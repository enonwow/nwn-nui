# UI container ports
NUI_UI_PORT=5180
NUI_UI_PREVIEW_PORT=4173

# Optional NWN API runner port (profile: nwn)
ITNWN_API_PORT=51871

# Optional host paths for real NWN integration (profile: nwn)
# If unset, compose uses local mock folders under ./.docker/
# ITNWN_MODULE_PATH_HOST=C:/Users/<you>/Documents/Neverwinter Nights/modules/temp0
# ITNWN_NWSCRIPT_DIR_HOST=C:/Users/<you>/Documents/NWScript

# Optional Vite base path for preview image
VITE_BASE_PATH=/
